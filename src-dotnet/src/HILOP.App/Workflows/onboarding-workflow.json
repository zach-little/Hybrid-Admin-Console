{
  "SchemaVersion": "1.0",
  "Id": "onboarding-workflow",
  "Name": "Onboarding Workflow",
  "Category": "Onboarding",
  "Form": {
    "Title": "Onboarding Workflow",
    "SubmitText": "Create User",
    "Fields": [
      {
        "Key": "FirstName",
        "Label": "First Name",
        "Control": "TextBox",
        "Required": true,
        "ValidationRegex": "^[A-Za-z][A-Za-z' -]*$",
        "ValidationMessage": "First name is required and must start with a letter."
      },
      {
        "Key": "MiddleInitial",
        "Label": "Middle Initial",
        "Control": "TextBox",
        "ValidationRegex": "^[A-Za-z]?$",
        "ValidationMessage": "Middle initial must be one letter."
      },
      {
        "Key": "IncludeMiddleInitial",
        "Label": "Include Middle Initial in SAM",
        "Control": "CheckBox",
        "DefaultValue": "false"
      },
      {
        "Key": "LastName",
        "Label": "Last Name",
        "Control": "TextBox",
        "Required": true,
        "ValidationRegex": "^[A-Za-z][A-Za-z' -]*$",
        "ValidationMessage": "Last name is required and must start with a letter."
      },
      {
        "Key": "JobTitle",
        "Label": "Job Title",
        "Control": "TextBox",
        "Required": true
      },
      {
        "Key": "ManagerSamAccountName",
        "Label": "Manager",
        "Control": "ComboBox",
        "Required": true,
        "OptionSource": "DirectoryManagers"
      },
      {
        "Key": "LocationNumber",
        "Label": "Work Location",
        "Control": "ComboBox",
        "Required": true,
        "Options": [
          { "Label": "1. Rivers", "Value": "1" },
          { "Label": "2. Remount", "Value": "2" },
          { "Label": "3. Virginia Beach", "Value": "3" },
          { "Label": "4. San Diego", "Value": "4" },
          { "Label": "5. Alexandria", "Value": "5" },
          { "Label": "6. Lexington", "Value": "6" }
        ]
      },
      {
        "Key": "DepartmentNumber",
        "Label": "Department",
        "Control": "ComboBox",
        "Required": true,
        "Options": [
          { "Label": "1. Dept 00 - Accounting", "Value": "1" },
          { "Label": "2. Dept 00 - Information Technology", "Value": "2" },
          { "Label": "3. Dept 00 - Executive", "Value": "3" },
          { "Label": "4. Dept 00 - Human Resources", "Value": "4" },
          { "Label": "5. Dept 01 - Contracts", "Value": "5" },
          { "Label": "6. Dept 01 - Operations", "Value": "6" },
          { "Label": "7. Dept 02 - DC/PAX/Charleston Division", "Value": "7" },
          { "Label": "8. Dept 03 - VABeach Division", "Value": "8" },
          { "Label": "9. Dept 04 - San Diego Division", "Value": "9" },
          { "Label": "10. Service Account", "Value": "10" }
        ]
      },
      {
        "Key": "HomeOrganizationNumber",
        "Label": "Home Organization",
        "Control": "ComboBox",
        "Required": true,
        "Options": [
          { "Label": "1. Draco Team", "Value": "1" },
          { "Label": "2. Pavo Team", "Value": "2" },
          { "Label": "3. Corvus Team", "Value": "3" }
        ]
      },
      {
        "Key": "EmployeeId",
        "Label": "Employee ID #",
        "Control": "TextBox",
        "Required": true
      },
      {
        "Key": "BadgeId",
        "Label": "Encoded Badge Number #",
        "Control": "TextBox",
        "Required": true
      },
      {
        "Key": "OfficePhone",
        "Label": "Office Phone",
        "Control": "TextBox",
        "ValidationRegex": "^$|^.{12}$",
        "ValidationMessage": "Office phone must be blank or exactly 12 characters, matching the legacy script rule."
      },
      {
        "Key": "MobilePhone",
        "Label": "Mobile Phone",
        "Control": "TextBox"
      },
      {
        "Key": "StartDate",
        "Label": "Expected Start Date",
        "Control": "TextBox",
        "ValidationRegex": "^$|^\\d{4}-\\d{2}-\\d{2}$",
        "ValidationMessage": "Start date must be blank or YYYY-MM-DD."
      },
      {
        "Key": "CreateMailbox",
        "Label": "Create Microsoft 365 / cloud mailbox",
        "Control": "CheckBox",
        "DefaultValue": "true"
      },
      {
        "Key": "CacRequired",
        "Label": "CAC Required",
        "Control": "CheckBox",
        "DefaultValue": "false"
      },
      {
        "Key": "JamisClaimSetup",
        "Label": "Launch JAMIS claim setup",
        "Control": "CheckBox",
        "DefaultValue": "true"
      },
      {
        "Key": "SendNewHireNotice",
        "Label": "Send new-hire onboarding notice",
        "Control": "CheckBox",
        "DefaultValue": "true"
      },
      {
        "Key": "NotificationSender",
        "Label": "Notification Sender",
        "Control": "TextBox",
        "DefaultValue": "New Hire Onboarding Notice <NEW-HIRE-INFO@littleinnovation.tech>"
      },
      {
        "Key": "NotificationRecipient",
        "Label": "Notification Recipient",
        "Control": "TextBox",
        "DefaultValue": "ITSupport <ITSupport@littleinnovation.tech>"
      },
      {
        "Key": "SmtpServer",
        "Label": "SMTP Server",
        "Control": "TextBox",
        "DefaultValue": "atlastechcloud.mail.protection.office365.us"
      },
      {
        "Key": "NothingRequested",
        "Label": "Nothing Requested",
        "Control": "CheckBox",
        "DefaultValue": "false"
      },
      {
        "Key": "TemporaryOfficeSpace",
        "Label": "Temporary Office Space",
        "Control": "CheckBox",
        "DefaultValue": "false"
      },
      {
        "Key": "PermanentOfficeSpace",
        "Label": "Permanent Office Space",
        "Control": "CheckBox",
        "DefaultValue": "false"
      },
      {
        "Key": "Desktop",
        "Label": "Desktop",
        "Control": "CheckBox",
        "DefaultValue": "false"
      },
      {
        "Key": "Laptop",
        "Label": "Laptop",
        "Control": "CheckBox",
        "DefaultValue": "false"
      },
      {
        "Key": "DockingStation",
        "Label": "Docking Station",
        "Control": "CheckBox",
        "DefaultValue": "false"
      },
      {
        "Key": "MouseKeyboard",
        "Label": "Mouse/Keyboard Combo",
        "Control": "CheckBox",
        "DefaultValue": "false"
      },
      {
        "Key": "Monitor",
        "Label": "Monitor",
        "Control": "CheckBox",
        "DefaultValue": "false"
      },
      {
        "Key": "DualMonitor",
        "Label": "Dual Monitors",
        "Control": "CheckBox",
        "DefaultValue": "false"
      },
      {
        "Key": "DeskPhone",
        "Label": "Desk Phone",
        "Control": "CheckBox",
        "DefaultValue": "false"
      },
      {
        "Key": "CellPhone",
        "Label": "Cell Phone",
        "Control": "CheckBox",
        "DefaultValue": "false"
      },
      {
        "Key": "Speakers",
        "Label": "Speakers",
        "Control": "CheckBox",
        "DefaultValue": "false"
      }
    ]
  },
  "ComputedVariables": [
    { "Key": "SamAccountName", "Type": "SamAccountName" },
    { "Key": "DisplayName", "Type": "DisplayName" },
    { "Key": "UserPrincipalName", "Type": "UserPrincipalName", "Value": "littleinnovation.tech" },
    { "Key": "OfficePhoneNormalized", "Type": "OfficePhone12OrNA", "Value": "OfficePhone" },
    { "Key": "RunDate", "Type": "CurrentDateTime", "Value": "yyyy-MM-dd HH:mm:ss" },
    { "Key": "RunBy", "Type": "CurrentUser" },
    { "Key": "OfficeDisplay", "Type": "StripNumberPrefix", "Value": "LocationNumberText" },
    { "Key": "DepartmentDisplay", "Type": "LegacyDepartmentDisplay", "Value": "DepartmentNumberText" },
    {
      "Key": "AssignStandardGroups",
      "Type": "Map",
      "Value": "{{DepartmentNumber}}",
      "Fallback": "true",
      "Map": {
        "10": "false"
      }
    },
    {
      "Key": "TargetOu",
      "Type": "Map",
      "Value": "{{LocationNumber}}:{{DepartmentNumber}}",
      "Fallback": "CN=Users,DC=atlas-tech,DC=com",
      "Map": {
        "1:1": "OU=Users,OU=Accounting,OU=Dept-00,OU=HQ,OU=Atlas-tech,DC=atlas-tech,DC=com",
        "1:2": "OU=Users,OU=IT,OU=Dept-00,OU=HQ,OU=Atlas-tech,DC=atlas-tech,DC=com",
        "1:3": "OU=Users,OU=Exec,OU=Dept-00,OU=HQ,OU=Atlas-tech,DC=atlas-tech,DC=com",
        "1:4": "OU=Users,OU=HR,OU=Dept-00,OU=HQ,OU=Atlas-tech,DC=atlas-tech,DC=com",
        "1:5": "OU=Users,OU=Contracts,OU=Dept-01,OU=HQ,OU=Atlas-tech,DC=atlas-tech,DC=com",
        "1:6": "OU=Users,OU=Operations,OU=Dept-01,OU=HQ,OU=Atlas-tech,DC=atlas-tech,DC=com",
        "1:7": "OU=Users,OU=Dept-02,OU=SC,OU=Atlas-tech,DC=atlas-tech,DC=com",
        "2:1": "OU=Users,OU=Accounting,OU=Dept-00,OU=HQ,OU=Atlas-tech,DC=atlas-tech,DC=com",
        "2:2": "OU=Users,OU=IT,OU=Dept-00,OU=HQ,OU=Atlas-tech,DC=atlas-tech,DC=com",
        "2:3": "OU=Users,OU=Exec,OU=Dept-00,OU=HQ,OU=Atlas-tech,DC=atlas-tech,DC=com",
        "2:4": "OU=Users,OU=HR,OU=Dept-00,OU=HQ,OU=Atlas-tech,DC=atlas-tech,DC=com",
        "2:5": "OU=Users,OU=Contracts,OU=Dept-01,OU=HQ,OU=Atlas-tech,DC=atlas-tech,DC=com",
        "2:6": "OU=Users,OU=Operations,OU=Dept-01,OU=HQ,OU=Atlas-tech,DC=atlas-tech,DC=com",
        "2:7": "OU=Users,OU=Dept-02,OU=SC,OU=Atlas-tech,DC=atlas-tech,DC=com",
        "3:8": "OU=Users,OU=Dept-03,OU=VA,OU=Atlas-tech,DC=atlas-tech,DC=com",
        "4:9": "OU=Users,OU=Dept-04,OU=CA,OU=Atlas-tech,DC=atlas-tech,DC=com",
        "5:7": "OU=Users,OU=Dept-02,OU=DC,OU=Atlas-tech,DC=atlas-tech,DC=com",
        "6:7": "OU=Users,OU=Dept-02,OU=MD,OU=Atlas-tech,DC=atlas-tech,DC=com",
        "1:10": "OU=Service Accounts,OU=Atlas-tech,DC=atlas-tech,DC=com",
        "2:10": "OU=Service Accounts,OU=Atlas-tech,DC=atlas-tech,DC=com",
        "3:10": "OU=Service Accounts,OU=Atlas-tech,DC=atlas-tech,DC=com",
        "4:10": "OU=Service Accounts,OU=Atlas-tech,DC=atlas-tech,DC=com",
        "5:10": "OU=Service Accounts,OU=Atlas-tech,DC=atlas-tech,DC=com",
        "6:10": "OU=Service Accounts,OU=Atlas-tech,DC=atlas-tech,DC=com"
      }
    },
    {
      "Key": "City",
      "Type": "Map",
      "Value": "{{LocationNumber}}",
      "Fallback": "Not Entered",
      "Map": {
        "1": "North Charleston",
        "2": "North Charleston",
        "3": "Virginia Beach",
        "4": "San Diego",
        "5": "Alexandria",
        "6": "Lexington"
      }
    },
    {
      "Key": "StreetAddress",
      "Type": "Map",
      "Value": "{{LocationNumber}}",
      "Fallback": "Not Entered",
      "Map": {
        "1": "5416-A Rivers Avenue - Suite 105",
        "2": "1101 Remount Rd, Suite 800",
        "3": "168 Business Park Drive, Suite 103",
        "4": "4250 Pacific Highway, 105",
        "5": "5911 Kingstowne Village Parkway Suite 310",
        "6": "Not Available"
      }
    },
    {
      "Key": "State",
      "Type": "Map",
      "Value": "{{LocationNumber}}",
      "Fallback": "NA",
      "Map": {
        "1": "SC",
        "2": "SC",
        "3": "VA",
        "4": "CA",
        "5": "VA",
        "6": "MD"
      }
    },
    {
      "Key": "PostalCode",
      "Type": "Map",
      "Value": "{{LocationNumber}}",
      "Fallback": "Not Available",
      "Map": {
        "1": "29406",
        "2": "29406",
        "3": "23462",
        "4": "92110",
        "5": "22315",
        "6": "Not Available"
      }
    },
    {
      "Key": "LocationGroup",
      "Type": "Map",
      "Value": "{{LocationNumber}}",
      "Fallback": "Atlas-Charleston",
      "Map": {
        "1": "Atlas-Charleston",
        "2": "Atlas-Charleston",
        "3": "Atlas-VABeach",
        "4": "Atlas-SD",
        "5": "Atlas-DC",
        "6": "Atlas-MD"
      }
    },
    {
      "Key": "HomeOrganizationGroup",
      "Type": "Map",
      "Value": "{{HomeOrganizationNumber}}",
      "Fallback": "NA",
      "Map": {
        "1": "Draco.Team",
        "2": "Pavo.Team",
        "3": "Corvus.Team"
      }
    },
    {
      "Key": "HomeOrganizationDisplayGroup",
      "Type": "Map",
      "Value": "{{HomeOrganizationNumber}}",
      "Fallback": "",
      "Map": {
        "1": "Draco Team",
        "2": "Pavo Team",
        "3": "Corvus Team"
      }
    }
  ],
  "Actions": [
    {
      "Id": "create-ad-user",
      "Name": "Create AD user",
      "Type": "CreateAdUser",
      "ProviderId": "ActiveDirectory",
      "Inputs": {
        "GivenName": "{{FirstName}}",
        "Surname": "{{LastName}}",
        "SamAccountName": "{{SamAccountName}}",
        "Department": "{{DepartmentDisplay}}",
        "Title": "{{JobTitle}}",
        "ManagerSamAccountName": "{{ManagerSamAccountName}}",
        "Office": "{{OfficeDisplay}}",
        "DisplayName": "{{DisplayName}}",
        "UserPrincipalName": "{{UserPrincipalName}}",
        "TargetOu": "{{TargetOu}}",
        "Company": "Atlas Technologies, Inc.",
        "EmployeeId": "{{EmployeeId}}",
        "BadgeId": "{{BadgeId}}",
        "OfficePhone": "{{OfficePhoneNormalized}}",
        "MobilePhone": "{{MobilePhone}}",
        "City": "{{City}}",
        "StreetAddress": "{{StreetAddress}}",
        "State": "{{State}}",
        "PostalCode": "{{PostalCode}}",
        "TemporaryPassword": "Temp123456",
        "Attribute:title": "{{JobTitle}}",
        "Attribute:badgeID": "{{BadgeId}}",
        "Attribute:ipPhone": "{{OfficePhoneNormalized}}"
      }
    },
    {
      "Id": "add-sc-cgusers",
      "Name": "Add SC_CGUsers",
      "Type": "AddGroup",
      "ProviderId": "ActiveDirectory",
      "RunWhen": "{{AssignStandardGroups}} == true",
      "Inputs": { "Identity": "{{SamAccountName}}", "Group": "SC_CGUsers" }
    },
    {
      "Id": "add-sd-cgusers",
      "Name": "Add SD_CGUsers",
      "Type": "AddGroup",
      "ProviderId": "ActiveDirectory",
      "RunWhen": "{{AssignStandardGroups}} == true",
      "Inputs": { "Identity": "{{SamAccountName}}", "Group": "SD_CGUsers" }
    },
    {
      "Id": "add-va-cgusers",
      "Name": "Add VABeach_CGUsers",
      "Type": "AddGroup",
      "ProviderId": "ActiveDirectory",
      "RunWhen": "{{AssignStandardGroups}} == true",
      "Inputs": { "Identity": "{{SamAccountName}}", "Group": "VABeach_CGUsers" }
    },
    {
      "Id": "add-location-group",
      "Name": "Add location group",
      "Type": "AddGroup",
      "ProviderId": "ActiveDirectory",
      "RunWhen": "{{AssignStandardGroups}} == true",
      "Inputs": { "Identity": "{{SamAccountName}}", "Group": "{{LocationGroup}}" }
    },
    {
      "Id": "add-home-organization-display-group",
      "Name": "Add home organization display group",
      "Type": "AddGroup",
      "ProviderId": "ActiveDirectory",
      "RunWhen": "{{AssignStandardGroups}} == true",
      "Inputs": { "Identity": "{{SamAccountName}}", "Group": "{{HomeOrganizationDisplayGroup}}" }
    },
    {
      "Id": "add-home-organization-group",
      "Name": "Add home organization group",
      "Type": "AddGroup",
      "ProviderId": "ActiveDirectory",
      "RunWhen": "{{AssignStandardGroups}} == true",
      "Inputs": { "Identity": "{{SamAccountName}}", "Group": "{{HomeOrganizationGroup}}" }
    },
    {
      "Id": "add-cac-group",
      "Name": "Add CAC holders group",
      "Type": "AddGroup",
      "ProviderId": "ActiveDirectory",
      "RunWhen": "{{AssignStandardGroups}} == true && {{CacRequired}} == true",
      "Inputs": { "Identity": "{{SamAccountName}}", "Group": "CAC_Holders" }
    },
    {
      "Id": "add-teentry",
      "Name": "Add TEEntry",
      "Type": "AddGroup",
      "ProviderId": "ActiveDirectory",
      "RunWhen": "{{AssignStandardGroups}} == true",
      "Inputs": { "Identity": "{{SamAccountName}}", "Group": "TEEntry" }
    },
    {
      "Id": "enable-remote-mailbox",
      "Name": "Enable remote mailbox",
      "Type": "EnableRemoteMailbox",
      "ProviderId": "ExchangeOnPremises",
      "RunWhen": "{{CreateMailbox}} == true",
      "Inputs": {
        "Identity": "{{SamAccountName}}",
        "PrimarySmtpAddress": "{{UserPrincipalName}}",
        "RemoteRoutingAddress": "{{SamAccountName}}@atlastechcloud.mail.onmicrosoft.com"
      }
    },
    {
      "Id": "send-new-hire-notice",
      "Name": "Send new-hire onboarding notice",
      "Type": "SendEmail",
      "RunWhen": "{{SendNewHireNotice}} == true",
      "Inputs": {
        "SmtpServer": "{{SmtpServer}}",
        "To": "{{NotificationRecipient}}",
        "From": "{{NotificationSender}}",
        "Subject": "[NEW-HIRE-INFO] New Hire Account {{DisplayName}} Has Been Created",
        "IsBodyHtml": "true",
        "Body": "<div style='font-family:Arial; font-size:14px;'><p><b>THIS EMAIL MAY CONTAIN CONFIDENTIAL OR PII DATA.<br>DO NOT FORWARD OUTSIDE THE ORGANIZATION.</b></p><p>The account for <b>{{DisplayName}}</b> has been created.<br>Please complete the ERP and inventory portions of onboarding.</p><h3 style='margin-top:25px;'>General Information</h3><table border='1' cellpadding='6' cellspacing='0' style='border-collapse:collapse;'><tr><th align='left'>Field</th><th align='left'>Value</th></tr><tr><td>Expected Start Date</td><td>{{StartDate}}</td></tr><tr><td>Script Run By</td><td>{{RunBy}}</td></tr><tr><td>Script Run Date</td><td>{{RunDate}}</td></tr><tr><td>Network Username</td><td>{{SamAccountName}}</td></tr><tr><td>User Principal Name</td><td>{{UserPrincipalName}}</td></tr><tr><td>Temporary Password</td><td>Temp123456</td></tr><tr><td>First Name</td><td>{{FirstName}}</td></tr><tr><td>Last Name</td><td>{{LastName}}</td></tr><tr><td>Middle Initial</td><td>{{MiddleInitial}}</td></tr><tr><td>Display Name</td><td>{{DisplayName}}</td></tr><tr><td>Use Middle Initial in Username</td><td>{{IncludeMiddleInitial}}</td></tr><tr><td>Title</td><td>{{JobTitle}}</td></tr><tr><td>Manager</td><td>{{ManagerSamAccountName}}</td></tr><tr><td>Department</td><td>{{DepartmentDisplay}}</td></tr><tr><td>Employee ID</td><td>{{EmployeeId}}</td></tr><tr><td>Badge ID</td><td>{{BadgeId}}</td></tr><tr><td>Office Phone</td><td>{{OfficePhoneNormalized}}</td></tr><tr><td>Mobile Phone</td><td>{{MobilePhone}}</td></tr><tr><td>Company</td><td>Atlas Technologies, Inc.</td></tr><tr><td>Office</td><td>{{OfficeDisplay}}</td></tr><tr><td>Street Address</td><td>{{StreetAddress}}</td></tr><tr><td>City</td><td>{{City}}</td></tr><tr><td>State</td><td>{{State}}</td></tr><tr><td>Postal Code</td><td>{{PostalCode}}</td></tr><tr><td>Email Address</td><td>{{UserPrincipalName}}</td></tr></table><h3 style='margin-top:25px;'>Group Assignments</h3><table border='1' cellpadding='6' cellspacing='0' style='border-collapse:collapse;'><tr><th align='left'>Group</th><th align='left'>Value</th></tr><tr><td>RODC SC</td><td>SC_CGUsers</td></tr><tr><td>RODC SD</td><td>SD_CGUsers</td></tr><tr><td>RODC VA</td><td>VABeach_CGUsers</td></tr><tr><td>Default Email Distribution</td><td>{{LocationGroup}}</td></tr></table><h3 style='margin-top:25px;'>Equipment &amp; Workspace Requests</h3><table border='1' cellpadding='6' cellspacing='0' style='border-collapse:collapse;'><tr><th align='left'>Asset</th><th align='left'>Requested</th></tr><tr><td>Nothing Requested</td><td>{{NothingRequested}}</td></tr><tr><td>Temporary Office Space</td><td>{{TemporaryOfficeSpace}}</td></tr><tr><td>Permanent Office Space</td><td>{{PermanentOfficeSpace}}</td></tr><tr><td>Desktop</td><td>{{Desktop}}</td></tr><tr><td>Laptop</td><td>{{Laptop}}</td></tr><tr><td>Docking Station</td><td>{{DockingStation}}</td></tr><tr><td>Mouse/Keyboard Combo</td><td>{{MouseKeyboard}}</td></tr><tr><td>Monitor</td><td>{{Monitor}}</td></tr><tr><td>Dual Monitors</td><td>{{DualMonitor}}</td></tr><tr><td>Desk Phone</td><td>{{DeskPhone}}</td></tr><tr><td>Cell Phone</td><td>{{CellPhone}}</td></tr><tr><td>Speakers</td><td>{{Speakers}}</td></tr></table></div>"
      }
    },
    {
      "Id": "launch-jamis-browser",
      "Name": "Launch JAMIS claim setup",
      "Type": "LaunchBrowser",
      "RunWhen": "{{AssignStandardGroups}} == true && {{JamisClaimSetup}} == true",
      "Inputs": {
        "Browser": "Chrome",
        "Url": "https://axisng.littleinnovation.tech/Main.aspx?ScreenId=DH000100&SilentLogin=Federation"
      }
    }
  ]
}
