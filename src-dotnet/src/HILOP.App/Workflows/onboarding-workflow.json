{
  "SchemaVersion": "1.0",
  "Id": "onboarding-workflow",
  "Name": "Example - Little Innovation Tech Onboarding Workflow",
  "Category": "Onboarding",
  "Form": {
    "Title": "Example - Little Innovation Tech Onboarding",
    "SubmitText": "Create User",
    "Fields": [
      {
        "Key": "FirstName",
        "Label": "First Name",
        "Control": "TextBox",
        "Required": true,
        "ValidationRegex": "^[A-Za-z][A-Za-z' -]*$",
        "ValidationMessage": "First name is required and must start with a letter."
      },
      {
        "Key": "MiddleInitial",
        "Label": "Middle Initial",
        "Control": "TextBox",
        "ValidationRegex": "^[A-Za-z]?$",
        "ValidationMessage": "Middle initial must be one letter."
      },
      {
        "Key": "IncludeMiddleInitial",
        "Label": "Include Middle Initial in SAM",
        "Control": "CheckBox",
        "DefaultValue": "false"
      },
      {
        "Key": "LastName",
        "Label": "Last Name",
        "Control": "TextBox",
        "Required": true,
        "ValidationRegex": "^[A-Za-z][A-Za-z' -]*$",
        "ValidationMessage": "Last name is required and must start with a letter."
      },
      {
        "Key": "JobTitle",
        "Label": "Job Title",
        "Control": "TextBox",
        "Required": true
      },
      {
        "Key": "ManagerSamAccountName",
        "Label": "Manager",
        "Control": "ComboBox",
        "Required": true,
        "OptionSource": "DirectoryManagers"
      },
      {
        "Key": "LocationNumber",
        "Label": "Work Location",
        "Control": "ComboBox",
        "Required": true,
        "Options": [
          {
            "Label": "1. Demo Headquarters",
            "Value": "1"
          },
          {
            "Label": "2. Demo Research Campus",
            "Value": "2"
          },
          {
            "Label": "3. Demo East Coast Office",
            "Value": "3"
          },
          {
            "Label": "4. Demo West Coast Office",
            "Value": "4"
          },
          {
            "Label": "5. Demo Capital Office",
            "Value": "5"
          },
          {
            "Label": "6. Demo Remote Operations",
            "Value": "6"
          }
        ]
      },
      {
        "Key": "DepartmentNumber",
        "Label": "Department",
        "Control": "ComboBox",
        "Required": true,
        "Options": [
          {
            "Label": "1. Corporate - Accounting",
            "Value": "1"
          },
          {
            "Label": "2. Corporate - Information Technology",
            "Value": "2"
          },
          {
            "Label": "3. Corporate - Executive",
            "Value": "3"
          },
          {
            "Label": "4. Corporate - Human Resources",
            "Value": "4"
          },
          {
            "Label": "5. Business - Contracts",
            "Value": "5"
          },
          {
            "Label": "6. Business - Operations",
            "Value": "6"
          },
          {
            "Label": "7. Technology - Engineering",
            "Value": "7"
          },
          {
            "Label": "8. Customer - Customer Success",
            "Value": "8"
          },
          {
            "Label": "9. Product - Product Management",
            "Value": "9"
          },
          {
            "Label": "10. Service Account",
            "Value": "10"
          }
        ]
      },
      {
        "Key": "HomeOrganizationNumber",
        "Label": "Home Organization",
        "Control": "ComboBox",
        "Required": true,
        "Options": [
          {
            "Label": "1. Aurora Team",
            "Value": "1"
          },
          {
            "Label": "2. Beacon Team",
            "Value": "2"
          },
          {
            "Label": "3. Catalyst Team",
            "Value": "3"
          }
        ]
      },
      {
        "Key": "EmployeeId",
        "Label": "Employee ID #",
        "Control": "TextBox",
        "Required": true
      },
      {
        "Key": "BadgeId",
        "Label": "Encoded Badge Number #",
        "Control": "TextBox",
        "Required": true
      },
      {
        "Key": "OfficePhone",
        "Label": "Office Phone",
        "Control": "TextBox",
        "ValidationRegex": "^$|^.{12}$",
        "ValidationMessage": "Office phone must be blank or exactly 12 characters, matching the legacy script rule."
      },
      {
        "Key": "MobilePhone",
        "Label": "Mobile Phone",
        "Control": "TextBox"
      },
      {
        "Key": "StartDate",
        "Label": "Expected Start Date",
        "Control": "TextBox",
        "ValidationRegex": "^$|^\\d{4}-\\d{2}-\\d{2}$",
        "ValidationMessage": "Start date must be blank or YYYY-MM-DD."
      },
      {
        "Key": "TemporaryPassword",
        "Label": "Temporary Password",
        "Control": "TextBox",
        "Required": true,
        "ValidationRegex": "^.{12,}$",
        "ValidationMessage": "Temporary password must be at least 12 characters."
      },
      {
        "Key": "CreateMailbox",
        "Label": "Create Microsoft 365 / cloud mailbox",
        "Control": "CheckBox",
        "DefaultValue": "true"
      },
      {
        "Key": "CacRequired",
        "Label": "CAC Required",
        "Control": "CheckBox",
        "DefaultValue": "false"
      },
      {
        "Key": "JamisClaimSetup",
        "Label": "Launch example HR / ERP setup",
        "Control": "CheckBox",
        "DefaultValue": "true"
      },
      {
        "Key": "SendNewHireNotice",
        "Label": "Send new-hire onboarding notice",
        "Control": "CheckBox",
        "DefaultValue": "true"
      },
      {
        "Key": "NotificationSender",
        "Label": "Notification Sender",
        "Control": "TextBox",
        "DefaultValue": "New Hire Onboarding Notice <NEW-HIRE-INFO@littleinnovation.tech>"
      },
      {
        "Key": "NotificationRecipient",
        "Label": "Notification Recipient",
        "Control": "TextBox",
        "DefaultValue": "ITSupport <ITSupport@littleinnovation.tech>"
      },
      {
        "Key": "SmtpServer",
        "Label": "SMTP Server",
        "Control": "TextBox",
        "DefaultValue": "smtp.example.invalid"
      },
      {
        "Key": "NothingRequested",
        "Label": "Nothing Requested",
        "Control": "CheckBox",
        "DefaultValue": "false"
      },
      {
        "Key": "TemporaryOfficeSpace",
        "Label": "Temporary Office Space",
        "Control": "CheckBox",
        "DefaultValue": "false"
      },
      {
        "Key": "PermanentOfficeSpace",
        "Label": "Permanent Office Space",
        "Control": "CheckBox",
        "DefaultValue": "false"
      },
      {
        "Key": "Desktop",
        "Label": "Desktop",
        "Control": "CheckBox",
        "DefaultValue": "false"
      },
      {
        "Key": "Laptop",
        "Label": "Laptop",
        "Control": "CheckBox",
        "DefaultValue": "false"
      },
      {
        "Key": "DockingStation",
        "Label": "Docking Station",
        "Control": "CheckBox",
        "DefaultValue": "false"
      },
      {
        "Key": "MouseKeyboard",
        "Label": "Mouse/Keyboard Combo",
        "Control": "CheckBox",
        "DefaultValue": "false"
      },
      {
        "Key": "Monitor",
        "Label": "Monitor",
        "Control": "CheckBox",
        "DefaultValue": "false"
      },
      {
        "Key": "DualMonitor",
        "Label": "Dual Monitors",
        "Control": "CheckBox",
        "DefaultValue": "false"
      },
      {
        "Key": "DeskPhone",
        "Label": "Desk Phone",
        "Control": "CheckBox",
        "DefaultValue": "false"
      },
      {
        "Key": "CellPhone",
        "Label": "Cell Phone",
        "Control": "CheckBox",
        "DefaultValue": "false"
      },
      {
        "Key": "Speakers",
        "Label": "Speakers",
        "Control": "CheckBox",
        "DefaultValue": "false"
      }
    ]
  },
  "ComputedVariables": [
    {
      "Key": "SamAccountName",
      "Type": "SamAccountName"
    },
    {
      "Key": "DisplayName",
      "Type": "DisplayName"
    },
    {
      "Key": "UserPrincipalName",
      "Type": "UserPrincipalName",
      "Value": "littleinnovation.tech"
    },
    {
      "Key": "OfficePhoneNormalized",
      "Type": "OfficePhone12OrNA",
      "Value": "OfficePhone"
    },
    {
      "Key": "RunDate",
      "Type": "CurrentDateTime",
      "Value": "yyyy-MM-dd HH:mm:ss"
    },
    {
      "Key": "RunBy",
      "Type": "CurrentUser"
    },
    {
      "Key": "OfficeDisplay",
      "Type": "StripNumberPrefix",
      "Value": "LocationNumberText"
    },
    {
      "Key": "DepartmentDisplay",
      "Type": "LegacyDepartmentDisplay",
      "Value": "DepartmentNumberText"
    },
    {
      "Key": "AssignStandardGroups",
      "Type": "Map",
      "Value": "{{DepartmentNumber}}",
      "Fallback": "true",
      "Map": {
        "10": "false"
      }
    },
    {
      "Key": "TargetOu",
      "Type": "Map",
      "Value": "{{LocationNumber}}:{{DepartmentNumber}}",
      "Fallback": "OU=Users,OU=HILOP Demo,DC=example,DC=invalid",
      "Map": {
        "1:1": "OU=Users,OU=Accounting,OU=Corporate,OU=Demo Headquarters,OU=HILOP Demo,DC=example,DC=invalid",
        "1:2": "OU=Users,OU=Information Technology,OU=Corporate,OU=Demo Headquarters,OU=HILOP Demo,DC=example,DC=invalid",
        "1:3": "OU=Users,OU=Executive,OU=Corporate,OU=Demo Headquarters,OU=HILOP Demo,DC=example,DC=invalid",
        "1:4": "OU=Users,OU=Human Resources,OU=Corporate,OU=Demo Headquarters,OU=HILOP Demo,DC=example,DC=invalid",
        "1:5": "OU=Users,OU=Contracts,OU=Business,OU=Demo Headquarters,OU=HILOP Demo,DC=example,DC=invalid",
        "1:6": "OU=Users,OU=Operations,OU=Business,OU=Demo Headquarters,OU=HILOP Demo,DC=example,DC=invalid",
        "2:7": "OU=Users,OU=Engineering,OU=Technology,OU=Demo Research Campus,OU=HILOP Demo,DC=example,DC=invalid",
        "3:8": "OU=Users,OU=Customer Success,OU=Customer,OU=Demo East Coast Office,OU=HILOP Demo,DC=example,DC=invalid",
        "4:9": "OU=Users,OU=Product Management,OU=Product,OU=Demo West Coast Office,OU=HILOP Demo,DC=example,DC=invalid",
        "5:5": "OU=Users,OU=Contracts,OU=Business,OU=Demo Capital Office,OU=HILOP Demo,DC=example,DC=invalid",
        "6:6": "OU=Users,OU=Operations,OU=Business,OU=Demo Remote Operations,OU=HILOP Demo,DC=example,DC=invalid",
        "1:10": "OU=Service Accounts,OU=HILOP Demo,DC=example,DC=invalid",
        "2:10": "OU=Service Accounts,OU=HILOP Demo,DC=example,DC=invalid",
        "3:10": "OU=Service Accounts,OU=HILOP Demo,DC=example,DC=invalid",
        "4:10": "OU=Service Accounts,OU=HILOP Demo,DC=example,DC=invalid",
        "5:10": "OU=Service Accounts,OU=HILOP Demo,DC=example,DC=invalid",
        "6:10": "OU=Service Accounts,OU=HILOP Demo,DC=example,DC=invalid"
      }
    },
    {
      "Key": "City",
      "Type": "Map",
      "Value": "{{LocationNumber}}",
      "Fallback": "Not Entered",
      "Map": {
        "1": "Innovation City",
        "2": "Research Park",
        "3": "Eastview",
        "4": "Westview",
        "5": "Capital District",
        "6": "Remote"
      }
    },
    {
      "Key": "StreetAddress",
      "Type": "Map",
      "Value": "{{LocationNumber}}",
      "Fallback": "Not Entered",
      "Map": {
        "1": "100 Innovation Way (Simulated)",
        "2": "200 Research Loop (Simulated)",
        "3": "300 Eastview Avenue (Simulated)",
        "4": "400 Westview Boulevard (Simulated)",
        "5": "500 Capital Plaza (Simulated)",
        "6": "Remote / No Fixed Office"
      }
    },
    {
      "Key": "State",
      "Type": "Map",
      "Value": "{{LocationNumber}}",
      "Fallback": "NA",
      "Map": {
        "1": "VA",
        "2": "NC",
        "3": "VA",
        "4": "CA",
        "5": "DC",
        "6": "NA"
      }
    },
    {
      "Key": "PostalCode",
      "Type": "Map",
      "Value": "{{LocationNumber}}",
      "Fallback": "Not Available",
      "Map": {
        "1": "00001",
        "2": "00002",
        "3": "00003",
        "4": "00004",
        "5": "00005",
        "6": "N/A"
      }
    },
    {
      "Key": "LocationGroup",
      "Type": "Map",
      "Value": "{{LocationNumber}}",
      "Fallback": "LIT-Demo-HQ",
      "Map": {
        "1": "LIT-Demo-HQ",
        "2": "LIT-Demo-Research",
        "3": "LIT-Demo-East",
        "4": "LIT-Demo-West",
        "5": "LIT-Demo-Capital",
        "6": "LIT-Demo-Remote"
      }
    },
    {
      "Key": "HomeOrganizationGroup",
      "Type": "Map",
      "Value": "{{HomeOrganizationNumber}}",
      "Fallback": "NA",
      "Map": {
        "1": "LIT.Aurora.Team",
        "2": "LIT.Beacon.Team",
        "3": "LIT.Catalyst.Team"
      }
    },
    {
      "Key": "HomeOrganizationDisplayGroup",
      "Type": "Map",
      "Value": "{{HomeOrganizationNumber}}",
      "Fallback": "",
      "Map": {
        "1": "LIT Aurora Team",
        "2": "LIT Beacon Team",
        "3": "LIT Catalyst Team"
      }
    }
  ],
  "Actions": [
    {
      "Id": "create-ad-user",
      "Name": "Create AD user",
      "Type": "CreateAdUser",
      "ProviderId": "ActiveDirectory",
      "Inputs": {
        "GivenName": "{{FirstName}}",
        "Surname": "{{LastName}}",
        "SamAccountName": "{{SamAccountName}}",
        "Department": "{{DepartmentDisplay}}",
        "Title": "{{JobTitle}}",
        "ManagerSamAccountName": "{{ManagerSamAccountName}}",
        "Office": "{{OfficeDisplay}}",
        "DisplayName": "{{DisplayName}}",
        "UserPrincipalName": "{{UserPrincipalName}}",
        "TargetOu": "{{TargetOu}}",
        "Company": "Little Innovation Tech",
        "EmployeeId": "{{EmployeeId}}",
        "BadgeId": "{{BadgeId}}",
        "OfficePhone": "{{OfficePhoneNormalized}}",
        "MobilePhone": "{{MobilePhone}}",
        "City": "{{City}}",
        "StreetAddress": "{{StreetAddress}}",
        "State": "{{State}}",
        "PostalCode": "{{PostalCode}}",
        "TemporaryPassword": "{{TemporaryPassword}}",
        "Attribute:title": "{{JobTitle}}",
        "Attribute:badgeID": "{{BadgeId}}",
        "Attribute:ipPhone": "{{OfficePhoneNormalized}}"
      }
    },
    {
      "Id": "add-sc-cgusers",
      "Name": "Add demo baseline users group",
      "Type": "AddGroup",
      "ProviderId": "ActiveDirectory",
      "RunWhen": "{{AssignStandardGroups}} == true",
      "Inputs": {
        "Identity": "{{SamAccountName}}",
        "Group": "LIT_Demo_AllUsers"
      }
    },
    {
      "Id": "add-sd-cgusers",
      "Name": "Add demo collaboration group",
      "Type": "AddGroup",
      "ProviderId": "ActiveDirectory",
      "RunWhen": "{{AssignStandardGroups}} == true",
      "Inputs": {
        "Identity": "{{SamAccountName}}",
        "Group": "LIT_Demo_Collaboration"
      }
    },
    {
      "Id": "add-va-cgusers",
      "Name": "Add demo security baseline group",
      "Type": "AddGroup",
      "ProviderId": "ActiveDirectory",
      "RunWhen": "{{AssignStandardGroups}} == true",
      "Inputs": {
        "Identity": "{{SamAccountName}}",
        "Group": "LIT_Demo_SecurityBaseline"
      }
    },
    {
      "Id": "add-location-group",
      "Name": "Add location group",
      "Type": "AddGroup",
      "ProviderId": "ActiveDirectory",
      "RunWhen": "{{AssignStandardGroups}} == true",
      "Inputs": {
        "Identity": "{{SamAccountName}}",
        "Group": "{{LocationGroup}}"
      }
    },
    {
      "Id": "add-home-organization-display-group",
      "Name": "Add home organization display group",
      "Type": "AddGroup",
      "ProviderId": "ActiveDirectory",
      "RunWhen": "{{AssignStandardGroups}} == true",
      "Inputs": {
        "Identity": "{{SamAccountName}}",
        "Group": "{{HomeOrganizationDisplayGroup}}"
      }
    },
    {
      "Id": "add-home-organization-group",
      "Name": "Add home organization group",
      "Type": "AddGroup",
      "ProviderId": "ActiveDirectory",
      "RunWhen": "{{AssignStandardGroups}} == true",
      "Inputs": {
        "Identity": "{{SamAccountName}}",
        "Group": "{{HomeOrganizationGroup}}"
      }
    },
    {
      "Id": "add-cac-group",
      "Name": "Add demo strong-authentication group",
      "Type": "AddGroup",
      "ProviderId": "ActiveDirectory",
      "RunWhen": "{{AssignStandardGroups}} == true && {{CacRequired}} == true",
      "Inputs": {
        "Identity": "{{SamAccountName}}",
        "Group": "LIT_Demo_StrongAuth"
      }
    },
    {
      "Id": "add-teentry",
      "Name": "Add demo time-entry group",
      "Type": "AddGroup",
      "ProviderId": "ActiveDirectory",
      "RunWhen": "{{AssignStandardGroups}} == true",
      "Inputs": {
        "Identity": "{{SamAccountName}}",
        "Group": "LIT_Demo_TimeEntry"
      }
    },
    {
      "Id": "enable-remote-mailbox",
      "Name": "Enable remote mailbox",
      "Type": "EnableRemoteMailbox",
      "ProviderId": "ExchangeOnPremises",
      "RunWhen": "{{CreateMailbox}} == true",
      "Inputs": {
        "Identity": "{{SamAccountName}}",
        "PrimarySmtpAddress": "{{UserPrincipalName}}",
        "RemoteRoutingAddress": "{{SamAccountName}}@mail.example.invalid"
      }
    },
    {
      "Id": "send-new-hire-notice",
      "Name": "Send new-hire onboarding notice",
      "Type": "SendEmail",
      "RunWhen": "{{SendNewHireNotice}} == true",
      "Inputs": {
        "SmtpServer": "{{SmtpServer}}",
        "To": "{{NotificationRecipient}}",
        "From": "{{NotificationSender}}",
        "Subject": "[NEW-HIRE-INFO] New Hire Account {{DisplayName}} Has Been Created",
        "IsBodyHtml": "true",
        "Body": "<div style='font-family:Arial; font-size:14px;'><p><b>THIS EMAIL MAY CONTAIN CONFIDENTIAL OR PII DATA.<br>DO NOT FORWARD OUTSIDE THE ORGANIZATION.</b></p><p>The account for <b>{{DisplayName}}</b> has been created.<br>Please complete the ERP and inventory portions of onboarding.</p><h3 style='margin-top:25px;'>General Information</h3><table border='1' cellpadding='6' cellspacing='0' style='border-collapse:collapse;'><tr><th align='left'>Field</th><th align='left'>Value</th></tr><tr><td>Expected Start Date</td><td>{{StartDate}}</td></tr><tr><td>Script Run By</td><td>{{RunBy}}</td></tr><tr><td>Script Run Date</td><td>{{RunDate}}</td></tr><tr><td>Network Username</td><td>{{SamAccountName}}</td></tr><tr><td>User Principal Name</td><td>{{UserPrincipalName}}</td></tr><tr><td>Temporary Password</td><td>Supplied securely through the workflow; not included in e-mail.</td></tr><tr><td>First Name</td><td>{{FirstName}}</td></tr><tr><td>Last Name</td><td>{{LastName}}</td></tr><tr><td>Middle Initial</td><td>{{MiddleInitial}}</td></tr><tr><td>Display Name</td><td>{{DisplayName}}</td></tr><tr><td>Use Middle Initial in Username</td><td>{{IncludeMiddleInitial}}</td></tr><tr><td>Title</td><td>{{JobTitle}}</td></tr><tr><td>Manager</td><td>{{ManagerSamAccountName}}</td></tr><tr><td>Department</td><td>{{DepartmentDisplay}}</td></tr><tr><td>Employee ID</td><td>{{EmployeeId}}</td></tr><tr><td>Badge ID</td><td>{{BadgeId}}</td></tr><tr><td>Office Phone</td><td>{{OfficePhoneNormalized}}</td></tr><tr><td>Mobile Phone</td><td>{{MobilePhone}}</td></tr><tr><td>Company</td><td>Little Innovation Tech</td></tr><tr><td>Office</td><td>{{OfficeDisplay}}</td></tr><tr><td>Street Address</td><td>{{StreetAddress}}</td></tr><tr><td>City</td><td>{{City}}</td></tr><tr><td>State</td><td>{{State}}</td></tr><tr><td>Postal Code</td><td>{{PostalCode}}</td></tr><tr><td>Email Address</td><td>{{UserPrincipalName}}</td></tr></table><h3 style='margin-top:25px;'>Group Assignments</h3><table border='1' cellpadding='6' cellspacing='0' style='border-collapse:collapse;'><tr><th align='left'>Group</th><th align='left'>Value</th></tr><tr><td>RODC SC</td><td>LIT_Demo_AllUsers</td></tr><tr><td>RODC SD</td><td>LIT_Demo_Collaboration</td></tr><tr><td>RODC VA</td><td>LIT_Demo_SecurityBaseline</td></tr><tr><td>Default Email Distribution</td><td>{{LocationGroup}}</td></tr></table><h3 style='margin-top:25px;'>Equipment &amp; Workspace Requests</h3><table border='1' cellpadding='6' cellspacing='0' style='border-collapse:collapse;'><tr><th align='left'>Asset</th><th align='left'>Requested</th></tr><tr><td>Nothing Requested</td><td>{{NothingRequested}}</td></tr><tr><td>Temporary Office Space</td><td>{{TemporaryOfficeSpace}}</td></tr><tr><td>Permanent Office Space</td><td>{{PermanentOfficeSpace}}</td></tr><tr><td>Desktop</td><td>{{Desktop}}</td></tr><tr><td>Laptop</td><td>{{Laptop}}</td></tr><tr><td>Docking Station</td><td>{{DockingStation}}</td></tr><tr><td>Mouse/Keyboard Combo</td><td>{{MouseKeyboard}}</td></tr><tr><td>Monitor</td><td>{{Monitor}}</td></tr><tr><td>Dual Monitors</td><td>{{DualMonitor}}</td></tr><tr><td>Desk Phone</td><td>{{DeskPhone}}</td></tr><tr><td>Cell Phone</td><td>{{CellPhone}}</td></tr><tr><td>Speakers</td><td>{{Speakers}}</td></tr></table></div>"
      }
    },
    {
      "Id": "launch-jamis-browser",
      "Name": "Launch example HR / ERP setup",
      "Type": "LaunchBrowser",
      "RunWhen": "{{AssignStandardGroups}} == true && {{JamisClaimSetup}} == true",
      "Inputs": {
        "Browser": "Chrome",
        "Url": "https://portal.example.invalid/onboarding/{{SamAccountName}}"
      }
    }
  ]
}
