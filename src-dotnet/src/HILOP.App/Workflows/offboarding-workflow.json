{
  "SchemaVersion": "1.0",
  "Id": "offboarding-workflow",
  "Name": "Offboarding Workflow",
  "Category": "Offboarding",
  "Form": {
    "Title": "Offboarding Workflow",
    "SubmitText": "Start Offboarding",
    "Fields": [
      {
        "Key": "UserIdentity",
        "Label": "User SAM Account or E-mail Address",
        "Control": "TextBox",
        "Required": true,
        "ValidationRegex": "^[A-Za-z0-9._%+@'-]+$",
        "ValidationMessage": "Enter a SAM account, UPN, or e-mail address."
      },
      {
        "Key": "EdiscoveryCaseName",
        "Label": "eDiscovery Case Name",
        "Control": "TextBox",
        "DefaultValue": "HILOP Offboarding - {{UserIdentity}}",
        "Required": true
      },
      {
        "Key": "DisabledUsersOu",
        "Label": "Disabled Users OU Distinguished Name",
        "Control": "TextBox",
        "DefaultValue": "OU=Disabled Users,DC=littleinnovation,DC=tech",
        "Required": true
      },
      {
        "Key": "SmtpServer",
        "Label": "SMTP Server",
        "Control": "TextBox",
        "DefaultValue": "littleinnovation-tech.mail.protection.office365.us",
        "Required": true
      },
      {
        "Key": "NotificationSender",
        "Label": "Notification Sender",
        "Control": "TextBox",
        "DefaultValue": "HILOP Offboarding <noreply@littleinnovation.tech>",
        "Required": true
      },
      {
        "Key": "NotificationRecipient",
        "Label": "Notification Recipient",
        "Control": "TextBox",
        "DefaultValue": "itsupport@littleinnovation.tech",
        "Required": true
      },
      {
        "Key": "Confirmed",
        "Label": "I confirm this offboarding workflow should disable access and apply hold",
        "Control": "CheckBox",
        "DefaultValue": "false",
        "Required": true
      }
    ]
  },
  "ComputedVariables": [
    {
      "Key": "RunDate",
      "Type": "CurrentDateTime",
      "Value": "yyyy-MM-dd HH:mm:ss"
    },
    {
      "Key": "RunBy",
      "Type": "CurrentUser"
    },
    {
      "Key": "GraphBaseUrl",
      "Type": "GraphBaseUrl"
    },
    {
      "Key": "GraphUserIdentity",
      "Type": "Template",
      "Value": "{{UserIdentity}}"
    },
    {
      "Key": "GraphUserPrincipalName",
      "Type": "Template",
      "Value": "{{UserIdentity}}"
    }
  ],
  "Actions": [
    {
      "Id": "approval",
      "Name": "Confirm offboarding approval",
      "Type": "Approval",
      "Inputs": {
        "Approved": "{{Confirmed}}",
        "Prompt": "Offboarding was not confirmed. Check the confirmation box to continue.",
        "Message": "Offboarding confirmed by {{RunBy}}."
      }
    },
    {
      "Id": "identity-branch",
      "Name": "Evaluate identity input",
      "Type": "ConditionalBranch",
      "Inputs": {
        "Condition": "{{UserIdentity}} != ''",
        "TrueMessage": "Required identities were supplied.",
        "FalseMessage": "User identity is required."
      }
    },
    {
      "Id": "create-ediscovery-case",
      "Name": "Create Purview eDiscovery case",
      "Type": "InvokeRestApi",
      "ProviderId": "MicrosoftGraph",
      "Inputs": {
        "Method": "POST",
        "Url": "{{GraphBaseUrl}}/security/cases/ediscoveryCases",
        "ContentType": "application/json",
        "Body": "{\"displayName\":\"{{EdiscoveryCaseName}}\",\"description\":\"HILOP offboarding case for {{UserIdentity}} created by {{RunBy}} on {{RunDate}}.\",\"externalId\":\"HILOP-Offboarding-{{UserIdentity}}\"}",
        "ExpectedStatusCodes": "201"
      },
      "Outputs": {
        "EdiscoveryCaseId": "id"
      }
    },
    {
      "Id": "create-ediscovery-custodian",
      "Name": "Create Purview eDiscovery custodian",
      "Type": "InvokeRestApi",
      "ProviderId": "MicrosoftGraph",
      "Inputs": {
        "Method": "POST",
        "Url": "{{GraphBaseUrl}}/security/cases/ediscoveryCases/{{EdiscoveryCaseId}}/custodians",
        "ContentType": "application/json",
        "Body": "{\"email\":\"{{GraphUserPrincipalName}}\"}",
        "ExpectedStatusCodes": "201"
      },
      "Outputs": {
        "EdiscoveryCustodianId": "id"
      }
    },
    {
      "Id": "create-ediscovery-user-source",
      "Name": "Create custodian mailbox and site source",
      "Type": "InvokeRestApi",
      "ProviderId": "MicrosoftGraph",
      "Inputs": {
        "Method": "POST",
        "Url": "{{GraphBaseUrl}}/security/cases/ediscoveryCases/{{EdiscoveryCaseId}}/custodians/{{EdiscoveryCustodianId}}/userSources",
        "ContentType": "application/json",
        "Body": "{\"email\":\"{{GraphUserPrincipalName}}\",\"includedSources\":\"mailbox,site\"}",
        "ExpectedStatusCodes": "201"
      },
      "Outputs": {
        "EdiscoveryUserSourceId": "id"
      }
    },
    {
      "Id": "apply-purview-hold",
      "Name": "Apply Purview eDiscovery hold",
      "Type": "InvokeRestApi",
      "ProviderId": "MicrosoftGraph",
      "Inputs": {
        "Method": "POST",
        "Url": "{{GraphBaseUrl}}/security/cases/ediscoveryCases/{{EdiscoveryCaseId}}/custodians/{{EdiscoveryCustodianId}}/applyHold",
        "ContentType": "application/json",
        "Body": "{}",
        "ExpectedStatusCodes": "200,202"
      }
    },
    {
      "Id": "revoke-active-sessions",
      "Name": "Revoke active Graph sessions",
      "Type": "InvokeRestApi",
      "ProviderId": "MicrosoftGraph",
      "Inputs": {
        "Method": "POST",
        "Url": "{{GraphBaseUrl}}/users/{{GraphUserIdentity}}/revokeSignInSessions",
        "ExpectedStatusCodes": "200,204"
      }
    },
    {
      "Id": "disable-entra-account",
      "Name": "Disable Entra ID account",
      "Type": "InvokeRestApi",
      "ProviderId": "MicrosoftGraph",
      "Inputs": {
        "Method": "PATCH",
        "Url": "{{GraphBaseUrl}}/users/{{GraphUserIdentity}}",
        "ContentType": "application/json",
        "Body": "{\"accountEnabled\":false}",
        "ExpectedStatusCodes": "200,204"
      }
    },
    {
      "Id": "settle-graph",
      "Name": "Allow cloud access changes to settle",
      "Type": "Delay",
      "Inputs": {
        "Seconds": "5"
      }
    },
    {
      "Id": "disable-and-move-ad",
      "Name": "Disable and move Active Directory account",
      "Type": "UpdateAdAttributes",
      "ProviderId": "ActiveDirectory",
      "Inputs": {
        "Identity": "{{UserIdentity}}",
        "Attribute:Enabled": "false",
        "Attribute:TargetOu": "{{DisabledUsersOu}}"
      }
    },
    {
      "Id": "notify-it",
      "Name": "Notify IT Support",
      "Type": "SendEmail",
      "Inputs": {
        "SmtpServer": "{{SmtpServer}}",
        "To": "{{NotificationRecipient}}",
        "From": "{{NotificationSender}}",
        "Subject": "HILOP offboarding completed for {{UserIdentity}}",
        "IsBodyHtml": "true",
        "Body": "<div style='font-family:Arial;font-size:14px;'><p>HILOP completed the offboarding workflow for <b>{{UserIdentity}}</b>.</p><table border='1' cellpadding='6' cellspacing='0' style='border-collapse:collapse;'><tr><th align='left'>Action</th><th align='left'>Status</th></tr><tr><td>Purview eDiscovery case</td><td>Created: {{EdiscoveryCaseId}}</td></tr><tr><td>Purview custodian</td><td>Created: {{EdiscoveryCustodianId}}</td></tr><tr><td>Purview custodian source</td><td>Created: {{EdiscoveryUserSourceId}}</td></tr><tr><td>Purview eDiscovery hold</td><td>Apply hold requested</td></tr><tr><td>Active sessions</td><td>Revocation requested</td></tr><tr><td>Entra ID account</td><td>Disable requested</td></tr><tr><td>Active Directory account</td><td>Disabled and moved to {{DisabledUsersOu}}</td></tr></table><p>Run by {{RunBy}} on {{RunDate}}.</p></div>"
      }
    }
  ]
}
