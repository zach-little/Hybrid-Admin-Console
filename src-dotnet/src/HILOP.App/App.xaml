<Application x:Class="HILOP.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Startup="OnStartup">
    <Application.Resources>
        <SolidColorBrush x:Key="HapBackgroundBrush" Color="#0B1220" />
        <SolidColorBrush x:Key="HapHeaderBrush" Color="#0F172A" />
        <SolidColorBrush x:Key="HapPanelBrush" Color="#111827" />
        <SolidColorBrush x:Key="HapCardBrush" Color="#1E293B" />
        <SolidColorBrush x:Key="HapBorderBrush" Color="#334155" />
        <SolidColorBrush x:Key="HapInkBrush" Color="#F8FAFC" />
        <SolidColorBrush x:Key="HapMutedBrush" Color="#94A3B8" />
        <SolidColorBrush x:Key="HapAccentBrush" Color="#38BDF8" />
        <SolidColorBrush x:Key="HapAccentDarkBrush" Color="#075985" />

        <Style TargetType="{x:Type Window}">
            <Setter Property="Background" Value="{StaticResource HapBackgroundBrush}" />
            <Setter Property="Foreground" Value="{StaticResource HapInkBrush}" />
        </Style>

        <Style TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{StaticResource HapInkBrush}" />
        </Style>

        <Style TargetType="{x:Type Label}">
            <Setter Property="Foreground" Value="{StaticResource HapInkBrush}" />
        </Style>

        <Style TargetType="{x:Type Button}">
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Background" Value="{StaticResource HapPanelBrush}" />
            <Setter Property="Foreground" Value="{StaticResource HapInkBrush}" />
            <Setter Property="BorderBrush" Value="#475569" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#12324A" />
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource HapAccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#082F49" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type TextBox}">
            <Setter Property="Background" Value="{StaticResource HapBackgroundBrush}" />
            <Setter Property="Foreground" Value="{StaticResource HapInkBrush}" />
            <Setter Property="BorderBrush" Value="#475569" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CaretBrush" Value="{StaticResource HapInkBrush}" />
            <Setter Property="Padding" Value="9,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="SelectionBrush" Value="{StaticResource HapAccentDarkBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TextBox}">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource HapAccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsReadOnly" Value="True">
                                <Setter Property="Opacity" Value="0.82" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type ComboBox}">
            <Setter Property="Background" Value="{StaticResource HapBackgroundBrush}" />
            <Setter Property="Foreground" Value="{StaticResource HapInkBrush}" />
            <Setter Property="BorderBrush" Value="#475569" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style TargetType="{x:Type ComboBoxItem}">
            <Setter Property="Background" Value="{StaticResource HapHeaderBrush}" />
            <Setter Property="Foreground" Value="{StaticResource HapInkBrush}" />
            <Setter Property="Padding" Value="8,5" />
        </Style>

        <Style TargetType="{x:Type Menu}">
            <Setter Property="Background" Value="{StaticResource HapHeaderBrush}" />
            <Setter Property="Foreground" Value="{StaticResource HapInkBrush}" />
        </Style>

        <Style TargetType="{x:Type MenuItem}">
            <Setter Property="Background" Value="{StaticResource HapHeaderBrush}" />
            <Setter Property="Foreground" Value="{StaticResource HapInkBrush}" />
            <Setter Property="Padding" Value="10,5" />
        </Style>

        <Style TargetType="{x:Type ContextMenu}">
            <Setter Property="Background" Value="{StaticResource HapHeaderBrush}" />
            <Setter Property="Foreground" Value="{StaticResource HapInkBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource HapBorderBrush}" />
        </Style>

        <Style TargetType="{x:Type TabControl}">
            <Setter Property="Background" Value="{StaticResource HapPanelBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource HapBorderBrush}" />
        </Style>

        <Style TargetType="{x:Type TabItem}">
            <Setter Property="Foreground" Value="{StaticResource HapInkBrush}" />
            <Setter Property="Background" Value="{StaticResource HapHeaderBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource HapBorderBrush}" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TabItem}">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1,1,1,0"
                                CornerRadius="5,5,0,0"
                                Padding="{TemplateBinding Padding}"
                                Margin="0,0,3,0">
                            <ContentPresenter ContentSource="Header"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#12324A" />
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource HapAccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource HapAccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type ListBox}">
            <Setter Property="Background" Value="{StaticResource HapBackgroundBrush}" />
            <Setter Property="Foreground" Value="{StaticResource HapInkBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource HapBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style TargetType="{x:Type ListBoxItem}">
            <Setter Property="Foreground" Value="{StaticResource HapInkBrush}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ListBoxItem}">
                        <Border x:Name="Chrome"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="1">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#12324A" />
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource HapAccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#172235" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type CheckBox}">
            <Setter Property="Foreground" Value="{StaticResource HapInkBrush}" />
        </Style>

        <Style TargetType="{x:Type DataGrid}">
            <Setter Property="Background" Value="{StaticResource HapBackgroundBrush}" />
            <Setter Property="Foreground" Value="{StaticResource HapInkBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource HapBorderBrush}" />
            <Setter Property="RowBackground" Value="{StaticResource HapHeaderBrush}" />
            <Setter Property="AlternatingRowBackground" Value="{StaticResource HapPanelBrush}" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HorizontalGridLinesBrush" Value="#26364F" />
        </Style>

        <Style TargetType="{x:Type DataGridColumnHeader}">
            <Setter Property="Background" Value="#12324A" />
            <Setter Property="Foreground" Value="{StaticResource HapInkBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="7,5" />
            <Setter Property="BorderBrush" Value="{StaticResource HapBorderBrush}" />
            <Setter Property="BorderThickness" Value="0,0,1,1" />
        </Style>

        <Style TargetType="{x:Type DataGridCell}">
            <Setter Property="Foreground" Value="{StaticResource HapInkBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="#26364F" />
            <Setter Property="Padding" Value="5,2" />
        </Style>

        <Style TargetType="{x:Type StatusBar}">
            <Setter Property="Background" Value="{StaticResource HapHeaderBrush}" />
            <Setter Property="Foreground" Value="{StaticResource HapMutedBrush}" />
        </Style>

        <Style TargetType="{x:Type ScrollBar}">
            <Setter Property="Background" Value="{StaticResource HapHeaderBrush}" />
            <Setter Property="Foreground" Value="{StaticResource HapAccentBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource HapBorderBrush}" />
        </Style>
    </Application.Resources>
</Application>
