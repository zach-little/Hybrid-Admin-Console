<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <WebPublishMethod>FileSystem</WebPublishMethod>
    <PublishProvider>FileSystem</PublishProvider>
    <LastUsedBuildConfiguration>Release</LastUsedBuildConfiguration>
    <LastUsedPlatform>Any CPU</LastUsedPlatform>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <LaunchSiteAfterPublish>false</LaunchSiteAfterPublish>
    <ExcludeApp_Data>false</ExcludeApp_Data>
    <publishUrl>..\..\..\artifacts\publish\HILOP\</publishUrl>
    <PublishDir>..\..\..\artifacts\publish\HILOP\</PublishDir>
    <PublishProtocol>FileSystem</PublishProtocol>
    <TargetFramework>net10.0-windows</TargetFramework>
    <LastUsedTargetFramework>net10.0-windows</LastUsedTargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <LastUsedRuntimeIdentifier>win-x64</LastUsedRuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishReadyToRun>false</PublishReadyToRun>
    <DebugType>embedded</DebugType>
    <DeleteExistingFiles>true</DeleteExistingFiles>
    <HilopEnableCodeSigning>false</HilopEnableCodeSigning>
  </PropertyGroup>
</Project>
