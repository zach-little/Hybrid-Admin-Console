<Window x:Class="HILOP.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HILOP"
        Width="1420"
        Height="900"
        MinWidth="1180"
        MinHeight="720"
        WindowStartupLocation="CenterScreen"
        Background="#0B1220">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Background="#0F172A"
                BorderBrush="#1E293B"
                BorderThickness="0,0,0,1"
                Padding="18,14">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock Text="HILOP"
                               Foreground="White"
                               FontSize="20"
                               FontWeight="SemiBold" />
                    <TextBlock Text="Native migration console"
                               Foreground="#CBD5E1"
                               Margin="0,3,0,0" />
                </StackPanel>
                <Button x:Name="LaunchButton"
                        DockPanel.Dock="Right"
                        Width="116"
                        Height="34"
                        Margin="10,0,0,0"
                        Content="Launch"
                        Click="OnLaunchClicked" />
                <Button x:Name="RefreshButton"
                        DockPanel.Dock="Right"
                        Width="116"
                        Height="34"
                        Content="Refresh"
                        Click="OnRefreshClicked" />
                <Button x:Name="BackToProfilesButton"
                        DockPanel.Dock="Right"
                        Width="140"
                        Height="34"
                        Content="Back to Profiles"
                        Visibility="Collapsed"
                        Click="OnBackToProfilesClicked" />
            </DockPanel>
        </Border>

        <Border Grid.Row="1"
                Margin="0"
                Background="#0B1220"
                BorderBrush="#1E293B"
                BorderThickness="0">
            <ContentControl x:Name="ContentHost" />
        </Border>
    </Grid>
</Window>
