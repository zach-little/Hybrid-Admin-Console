<UserControl x:Class="HAP.Presentation.RuntimeProfiles.RuntimeProfileSelectorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="720"
             MinHeight="420">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" LastChildFill="True" Margin="0,0,0,16">
            <ProgressBar DockPanel.Dock="Right"
                         Width="160"
                         Height="8"
                         Margin="16,12,0,0"
                         IsIndeterminate="{Binding IsLoading}" />
            <StackPanel>
                <TextBlock Text="Runtime Profile"
                           FontSize="24"
                           FontWeight="SemiBold" />
                <TextBlock Text="{Binding ProgressMessage}"
                           Margin="0,4,0,0"
                           Opacity="0.75" />
            </StackPanel>
        </DockPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="24" />
                <ColumnDefinition Width="3*" />
            </Grid.ColumnDefinitions>

            <ListBox Grid.Column="0"
                     ItemsSource="{Binding Profiles}"
                     SelectedItem="{Binding SelectedProfile, Mode=TwoWay}"
                     BorderThickness="1"
                     HorizontalContentAlignment="Stretch"
                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="{Binding DisplayName}"
                                       FontWeight="SemiBold" />
                            <TextBlock Grid.Row="1"
                                       Text="{Binding ProviderSummary}"
                                       Margin="0,4,0,0"
                                       TextTrimming="CharacterEllipsis"
                                       Opacity="0.72" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <Border Grid.Column="2"
                    BorderThickness="1"
                    Padding="18">
                <StackPanel>
                    <TextBlock Text="{Binding SelectedProfile.DisplayName}"
                               FontSize="20"
                               FontWeight="SemiBold" />
                    <UniformGrid Columns="2" Margin="0,18,0,0">
                        <StackPanel Margin="0,0,18,14">
                            <TextBlock Text="Mode" Opacity="0.65" />
                            <TextBlock Text="{Binding SelectedProfile.RuntimeMode}" FontWeight="SemiBold" />
                        </StackPanel>
                        <StackPanel Margin="0,0,0,14">
                            <TextBlock Text="Environment" Opacity="0.65" />
                            <TextBlock Text="{Binding SelectedProfile.Environment}" FontWeight="SemiBold" />
                        </StackPanel>
                        <StackPanel Margin="0,0,18,14">
                            <TextBlock Text="Cloud" Opacity="0.65" />
                            <TextBlock Text="{Binding SelectedProfile.CloudEnvironment}" FontWeight="SemiBold" />
                        </StackPanel>
                        <StackPanel Margin="0,0,0,14">
                            <TextBlock Text="Organization" Opacity="0.65" />
                            <TextBlock Text="{Binding SelectedProfile.Organization}" FontWeight="SemiBold" />
                        </StackPanel>
                    </UniformGrid>
                    <TextBlock Text="Providers"
                               Margin="0,12,0,4"
                               Opacity="0.65" />
                    <TextBlock Text="{Binding SelectedProfile.ProviderSummary}"
                               TextWrapping="Wrap" />
                    <TextBlock Text="{Binding ValidationMessage}"
                               Margin="0,18,0,0"
                               FontWeight="SemiBold" />
                    <TextBlock Text="{Binding RuntimeStatus}"
                               Margin="0,18,0,6"
                               Opacity="0.75" />
                    <ItemsControl ItemsSource="{Binding ProviderHealth}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderThickness="0,1,0,0"
                                        Padding="0,8,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="100" />
                                            <ColumnDefinition Width="120" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Message}"
                                                       TextTrimming="CharacterEllipsis"
                                                       Opacity="0.7" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding Mode}"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding Status}"
                                                   VerticalAlignment="Center"
                                                   FontWeight="SemiBold" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </Grid>

        <DockPanel Grid.Row="2" Margin="0,16,0,0">
            <TextBlock Text="{Binding ErrorMessage}"
                       Foreground="#B42318"
                       VerticalAlignment="Center" />
            <Button DockPanel.Dock="Right"
                    Width="96"
                    Height="32"
                    Content="Cancel"
                    IsEnabled="{Binding CanCancel}" />
        </DockPanel>
    </Grid>
</UserControl>
