<Window x:Class="HAP.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Hybrid Admin Platform"
        Width="1100"
        Height="720"
        MinWidth="900"
        MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="#F5F7FA">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Background="#0F172A"
                Padding="18,14">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock Text="Hybrid Admin Platform"
                               Foreground="White"
                               FontSize="20"
                               FontWeight="SemiBold" />
                    <TextBlock Text="Native migration console"
                               Foreground="#CBD5E1"
                               Margin="0,3,0,0" />
                </StackPanel>
                <Button x:Name="LaunchButton"
                        DockPanel.Dock="Right"
                        Width="116"
                        Height="34"
                        Margin="10,0,0,0"
                        Content="Launch"
                        Click="OnLaunchClicked" />
                <Button x:Name="RefreshButton"
                        DockPanel.Dock="Right"
                        Width="116"
                        Height="34"
                        Content="Refresh"
                        Click="OnRefreshClicked" />
            </DockPanel>
        </Border>

        <Border Grid.Row="1"
                Margin="18"
                Background="White"
                BorderBrush="#D8DEE8"
                BorderThickness="1">
            <ContentControl x:Name="ContentHost" />
        </Border>
    </Grid>
</Window>
