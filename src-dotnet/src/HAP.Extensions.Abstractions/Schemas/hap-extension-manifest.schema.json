{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hap.local/schemas/hap-extension-manifest.schema.json",
  "title": "HAP Extension Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifestVersion",
    "providerId",
    "displayName",
    "publisher",
    "providerVersion",
    "apiVersion",
    "implementation",
    "entryPoint",
    "capabilities"
  ],
  "properties": {
    "manifestVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" },
    "providerId": { "type": "string", "minLength": 1 },
    "displayName": { "type": "string", "minLength": 1 },
    "publisher": { "type": "string", "minLength": 1 },
    "providerVersion": { "type": "string", "minLength": 1 },
    "apiVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" },
    "implementation": { "enum": [ "NativeDotNet", "PowerShell" ] },
    "entryPoint": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "assemblyPath": { "type": "string" },
        "typeName": { "type": "string" },
        "modulePath": { "type": "string" },
        "requiredPowerShellEdition": { "type": "string" },
        "minimumPowerShellVersion": { "type": "string" }
      }
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [ "id", "operations" ],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "displayName": { "type": "string" },
          "operations": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "requiredPermissions": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "configurationSchema": { "type": "object" }
  }
}
