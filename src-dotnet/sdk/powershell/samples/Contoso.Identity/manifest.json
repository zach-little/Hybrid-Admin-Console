{
  "manifestVersion": "1.0",
  "providerId": "contoso.identity",
  "displayName": "Contoso Identity Sample",
  "publisher": "Contoso",
  "providerVersion": "1.0.0",
  "apiVersion": "1.0",
  "implementation": "PowerShell",
  "entryPoint": {
    "modulePath": ".\\Contoso.Identity.Provider.psm1",
    "requiredPowerShellEdition": "PowerShell7",
    "minimumPowerShellVersion": "7.4"
  },
  "capabilities": [
    {
      "id": "identity.user.read",
      "displayName": "Read sample users",
      "operations": [
        "TestConnection",
        "GetSampleUser"
      ]
    }
  ],
  "requiredPermissions": [
    "Directory.Read.All"
  ],
  "configurationSchema": {
    "type": "object",
    "properties": {
      "tenantName": {
        "type": "string",
        "title": "Tenant Name"
      }
    }
  }
}
